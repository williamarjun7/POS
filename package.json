{
  "name": "pos-dashboard",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build && tsc -p electron/tsconfig.json && electron-builder",
    "build:analyze": "ANALYZE_BUNDLE=true vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win --config",
    "electron:build:dir": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win --dir",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:start": "electron .",
    "electron:ci": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win --config",
    "release": "npm run release:patch",
    "electron:release": "npm version patch --no-git-tag-version && npm run electron:build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest bench",
    "test:e2e": "cd e2e && npx playwright test",
    "test:e2e:ui": "cd e2e && npx playwright test --ui",
    "test:e2e:debug": "cd e2e && npx playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "lighthouse": "lighthouse http://localhost:5173 --view --output-path=./lighthouse-reports/report.html",
    "lighthouse:ci": "lhci autorun",
    "k6:login": "k6 run tests/k6/login.js",
    "k6:menu": "k6 run tests/k6/menu-load.js",
    "k6:orders": "k6 run tests/k6/order-creation.js",
    "k6:payments": "k6 run tests/k6/payment-processing.js",
    "k6:dashboard": "k6 run tests/k6/dashboard-load.js",
    "k6:booking": "k6 run tests/k6/rooms-booking.js",
    "k6:mixed": "k6 run tests/k6/mixed-workload.js",
    "k6:stress": "k6 run --stage 1m:50,1m:100,1m:200,1m:300,1m:500,1m:1000,2m:1000,1m:0 tests/k6/mixed-workload.js",
    "k6:endurance": "k6 run --stage 5m:20,8h:20,5m:0 tests/k6/mixed-workload.js",
    "db:profile": "psql \"$DATABASE_URL\" -f tests/db/performance-profiling.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f tests/db/seed-large-dataset.sql",
    "perf:all": "npm run build:analyze && npm run test:perf",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "cap:android": "npm run cap:build && npx cap open android",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/sync-android-version.mjs",
    "version:minor": "npm version minor --no-git-tag-version && node scripts/sync-android-version.mjs",
    "version:major": "npm version major --no-git-tag-version && node scripts/sync-android-version.mjs",
    "cap:release": "node scripts/sync-android-version.mjs && cd android && gradlew.bat assembleRelease",
    "cap:bundle": "node scripts/sync-android-version.mjs && cd android && gradlew.bat bundleRelease",
    "release:patch": "npm version patch --no-git-tag-version && node scripts/release-tag.mjs",
    "release:minor": "npm version minor --no-git-tag-version && node scripts/release-tag.mjs",
    "release:major": "npm version major --no-git-tag-version && node scripts/release-tag.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@insforge/sdk": "^1.4.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.101.2",
    "boneyard-js": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "node-thermal-printer": "^4.6.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "auto-launch": "^5.0.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "description": "A modern Point of Sale application built with React, TypeScript, and Vite.",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamarjun7/POS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/williamarjun7/POS/issues"
  },
  "homepage": "https://github.com/williamarjun7/POS#readme",
  "build": {
    "appId": "com.highlandscafemotelinn.pos",
    "productName": "Highlands Cafe & Motel Inn POS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Highlands Cafe & Motel Inn POS"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "williamarjun7",
        "repo": "POS",
        "releaseType": "release"
      }
    ]
  }
}
